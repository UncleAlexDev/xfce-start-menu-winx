#: src/sys_cmd.py:173
msgid "Command... (Tab to complete)"
msgstr "Lệnh... (Nhấn Tab để hoàn tất)"

#: src/sys_cmd.py:332
#, python-brace-format
msgid "Failed to run '{cmd}'"
msgstr "Không thể chạy '{cmd}'"

#: src/sys_shortcuts.py:151
msgid "Keyboard shortcuts mismatch detected for Xfce Start Menu."
msgstr "Phát hiện xung đột phím tắt cho Xfce Start Menu."

#: src/sys_shortcuts.py:156
msgid ""
"Fix incompatible shortcuts now?\n"
"If left as is, system menu hotkeys may work unstably.\n"
"You can also review them manually in: Settings → Keyboard → Application "
"Shortcuts.\n"
"\n"
msgstr ""
"Sửa các phím tắt không tương thích ngay bây giờ?\n"
"Nếu giữ nguyên, các phím nóng của menu hệ thống có thể hoạt động không ổn "
"định.\n"
"Bạn cũng có thể kiểm tra thủ công tại: Cài đặt → Bàn phím → Phím tắt ứng "
"dụng.\n"
"\n"

#: src/sys_shortcuts.py:163
msgid "Leave as is"
msgstr "Giữ nguyên"

#: src/sys_shortcuts.py:164
msgid "Open Keyboard..."
msgstr "Mở cài đặt bàn phím..."

#: src/sys_shortcuts.py:165
msgid "Fix now"
msgstr "Sửa ngay"

