#: src/sys_actions.py:52
#, python-brace-format
msgid ""
"Failed to execute command '{cmd}':\n"
"{err}"
msgstr ""
"Không thể thực thi lệnh '{cmd}':\n"
"{err}"

#: src/sys_actions.py:73
#, python-brace-format
msgid ""
"Application '{bin}' is not installed.\n"
"Install package '{pkg}' now?"
msgstr ""
"Ứng dụng '{bin}' chưa được cài đặt.\n"
"Cài đặt gói '{pkg}' ngay bây giờ?"

#: src/sys_actions.py:86
msgid "Installation complete. You can close this terminal."
msgstr "Cài đặt hoàn tất. Bạn có thể đóng cửa sổ dòng lệnh này."

#: src/sys_actions.py:87
msgid "Installation failed! You can close this terminal."
msgstr "Cài đặt thất bại! Bạn có thể đóng cửa sổ dòng lệnh này."

#: src/sys_actions.py:172
#, python-brace-format
msgid ""
"Continue with\n"
"{cmd}"
msgstr ""
"Tiếp tục với\n"
"{cmd}"

#: src/sys_actions.py:173 src/sys_cmd.py:146
msgid "Cancel"
msgstr "Hủy"

#: src/sys_actions.py:189
#, python-brace-format
msgid ""
"Command '{bin}' is not installed on your system, and package '{pkg}' was not "
"found in available software repositories.\n"
"\n"
"Check the 'cmd' and 'pkg' values for '{key}' in:\n"
"{path}"
msgstr ""
"Lệnh '{bin}' chưa được cài đặt trên hệ thống của bạn và không tìm thấy gói "
"'{pkg}' trong các kho phần mềm hiện có.\n"
"\n"
"Kiểm tra các giá trị 'cmd' và 'pkg' cho '{key}' trong:\n"
"{path}"

#: src/sys_actions.py:193 src/sys_actions.py:350 src/sys_actions.py:372
msgid "System Menu — Configuration Error"
msgstr "Menu hệ thống — Lỗi cấu hình"

#: src/sys_actions.py:230
#, python-brace-format
msgid ""
"Check file:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"Kiểm tra tệp:\n"
"{path}\n"
"\n"
"(hoặc xóa tệp để khôi phục mặc định)\n"
"\n"

#: src/sys_actions.py:248
#, python-brace-format
msgid ""
"Failed to read file:\n"
"{path}\n"
"\n"
"{err}"
msgstr ""
"Không thể đọc tệp:\n"
"{path}\n"
"\n"
"{err}"

#: src/sys_actions.py:263
#, python-brace-format
msgid ""
"JSON syntax error in configuration file (line {line}, column {col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"
msgstr ""
"Lỗi cú pháp JSON trong tệp cấu hình (dòng {line}, cột {col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"

#: src/sys_actions.py:267
#, python-brace-format
msgid ""
"Configuration error:\n"
"{err}\n"
"\n"
"{hint}"
msgstr ""
"Lỗi cấu hình:\n"
"{err}\n"
"\n"
"{hint}"

#: src/sys_actions.py:283
#, python-brace-format
msgid ""
"Empty command specified for menu item '{key}'.\n"
"Enter a valid command or reset the setting.\n"
"\n"
"{hint}"
msgstr ""
"Lệnh trống được chỉ định cho mục menu '{key}'.\n"
"Nhập lệnh hợp lệ hoặc đặt lại cài đặt.\n"
"\n"
"{hint}"

#: src/sys_actions.py:297
#, python-brace-format
msgid ""
"Invalid command ('cmd') for menu item '{key}'.\n"
"The value must be a non-empty string or null.\n"
"\n"
"{hint}"
msgstr ""
"Lệnh ('cmd') không hợp lệ cho mục menu '{key}'.\n"
"Giá trị phải là chuỗi không rỗng hoặc null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:307
#, python-brace-format
msgid ""
"Invalid package name ('pkg') for menu item '{key}'.\n"
"Specify a valid APT package name or set 'pkg' to null.\n"
"\n"
"{hint}"
msgstr ""
"Tên gói không hợp lệ ('pkg') cho mục menu '{key}'.\n"
"Chỉ định tên gói APT hợp lệ hoặc đặt 'pkg' thành null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:325
#, python-brace-format
msgid ""
"Invalid configuration format for menu item '{key}'.\n"
"Expected a command string or an object {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"
msgstr ""
"Định dạng cấu hình không hợp lệ cho mục menu '{key}'.\n"
"Yêu cầu chuỗi lệnh hoặc đối tượng {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"

#: src/sys_actions.py:356
msgid ""
"No suitable application.\n"
"Under developing..."
msgstr ""
"Không có ứng dụng phù hợp.\n"
"Đang phát triển..."

#: src/sys_actions.py:367
#, python-brace-format
msgid ""
"Invalid command syntax for menu item '{key}'.\n"
"Check the quotes and arguments in:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"Cú pháp lệnh không hợp lệ cho mục menu '{key}'.\n"
"Kiểm tra dấu ngoặc kép và đối số trong:\n"
"{path}\n"
"\n"
"(hoặc xóa tệp để khôi phục mặc định)\n"
"\n"

