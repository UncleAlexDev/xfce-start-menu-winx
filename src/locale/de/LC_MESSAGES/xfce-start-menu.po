"{path}\n"
"\n"
"{err}"

#: src/sys_actions.py:263
#, python-brace-format
msgid ""
"JSON syntax error in configuration file (line {line}, column {col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"
msgstr ""
"JSON-Syntaxfehler in der Konfigurationsdatei (Zeile {line}, Spalte {col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"

#: src/sys_actions.py:267
#, python-brace-format
msgid ""
"Configuration error:\n"
"{err}\n"
"\n"
"{hint}"
msgstr ""
"Konfigurationsfehler:\n"
"{err}\n"
"\n"
"{hint}"

#: src/sys_actions.py:283
#, python-brace-format
msgid ""
"Empty command specified for menu item '{key}'.\n"
"Enter a valid command or reset the setting.\n"
"\n"
"{hint}"
msgstr ""
"Leerer Befehl für Menüpunkt '{key}' angegeben.\n"
"Geben Sie einen gültigen Befehl ein oder setzen Sie die Einstellung zurück.\n"
"\n"
"{hint}"

#: src/sys_actions.py:297
#, python-brace-format
msgid ""
"Invalid command ('cmd') for menu item '{key}'.\n"
"The value must be a non-empty string or null.\n"
"\n"
"{hint}"
msgstr ""
"Ungültiger Befehl ('cmd') für Menüpunkt '{key}'.\n"
"Der Wert muss eine nicht-leere Zeichenkette oder null sein.\n"
"\n"
"{hint}"

#: src/sys_actions.py:307
#, python-brace-format
msgid ""
"Invalid package name ('pkg') for menu item '{key}'.\n"
"Specify a valid APT package name or set 'pkg' to null.\n"
"\n"
"{hint}"
msgstr ""
"Ungültiger Paketname ('pkg') für Menüpunkt '{key}'.\n"
"Geben Sie einen gültigen APT-Paketnamen an oder setzen Sie 'pkg' auf null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:325
#, python-brace-format
msgid ""
"Invalid configuration format for menu item '{key}'.\n"
"Expected a command string or an object {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"
msgstr ""
"Ungültiges Konfigurationsformat für Menüpunkt '{key}'.\n"
"Erwartet wurde eine Befehlszeichenkette oder ein Objekt {{\"cmd\": ..., "
"\"pkg\": ...}}.\n"
"\n"
"{hint}"

#: src/sys_actions.py:356
msgid ""
"No suitable application.\n"
"Under developing..."
msgstr ""
"Keine passende Anwendung.\n"
"In Entwicklung..."

#: src/sys_actions.py:367
#, python-brace-format
msgid ""
"Invalid command syntax for menu item '{key}'.\n"
"Check the quotes and arguments in:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"Ungültige Befehlssyntax für Menüpunkt '{key}'.\n"
"Überprüfen Sie die Anführungszeichen und Argumente in:\n"
"{path}\n"
"\n"
"(oder löschen Sie die Datei, um die Standardwerte wiederherzustellen)\n"
"\n"

