#: src/sys_actions.py:73
#, python-brace-format
msgid ""
"Application '{bin}' is not installed.\n"
"Install package '{pkg}' now?"
msgstr ""
"Die Anwendung '{bin}' ist nicht installiert.\n"
"Paket '{pkg}' jetzt installieren?"

#: src/sys_actions.py:86
msgid "Installation complete. You can close this terminal."
msgstr "Installation abgeschlossen. Sie können dieses Terminal schließen."

#: src/sys_actions.py:87
msgid "Installation failed! You can close this terminal."
msgstr "Installation fehlgeschlagen! Sie können dieses Terminal schließen."

#: src/sys_actions.py:172
#, python-brace-format
