"{path}\n"
"\n"
"{err}"

#: src/sys_actions.py:263
#, python-brace-format
msgid ""
"JSON syntax error in configuration file (line {line}, column {col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"
msgstr ""
"Errore di sintassi JSON nel file di configurazione (riga {line}, colonna "
"{col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"

#: src/sys_actions.py:267
#, python-brace-format
msgid ""
"Configuration error:\n"
"{err}\n"
"\n"
"{hint}"
msgstr ""
"Errore di configurazione:\n"
"{err}\n"
"\n"
"{hint}"

#: src/sys_actions.py:283
#, python-brace-format
msgid ""
"Empty command specified for menu item '{key}'.\n"
"Enter a valid command or reset the setting.\n"
"\n"
"{hint}"
msgstr ""
"Comando vuoto specificato per la voce di menu '{key}'.\n"
"Inserisci un comando valido o ripristina l'impostazione.\n"
"\n"
"{hint}"

#: src/sys_actions.py:297
#, python-brace-format
msgid ""
"Invalid command ('cmd') for menu item '{key}'.\n"
"The value must be a non-empty string or null.\n"
"\n"
"{hint}"
msgstr ""
"Comando non valido ('cmd') per la voce di menu '{key}'.\n"
"Il valore deve essere una stringa non vuota o null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:307
#, python-brace-format
msgid ""
"Invalid package name ('pkg') for menu item '{key}'.\n"
"Specify a valid APT package name or set 'pkg' to null.\n"
"\n"
"{hint}"
msgstr ""
"Nome del pacchetto non valido ('pkg') per la voce di menu '{key}'.\n"
"Specifica un nome di pacchetto APT valido o imposta 'pkg' su null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:325
#, python-brace-format
msgid ""
"Invalid configuration format for menu item '{key}'.\n"
"Expected a command string or an object {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"
msgstr ""
"Formato di configurazione non valido per la voce di menu '{key}'.\n"
"Prevista una stringa di comando o un oggetto {{\"cmd\": ..., "
"\"pkg\": ...}}.\n"
"\n"
"{hint}"

#: src/sys_actions.py:356
msgid ""
"No suitable application.\n"
"Under developing..."
msgstr ""
"Nessuna applicazione adatta.\n"
"In fase di sviluppo..."

#: src/sys_actions.py:367
#, python-brace-format
msgid ""
"Invalid command syntax for menu item '{key}'.\n"
"Check the quotes and arguments in:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"Sintassi del comando non valida per la voce di menu '{key}'.\n"
"Controlla le virgolette e gli argomenti in:\n"
"{path}\n"
"\n"
"(oppure elimina il file per ripristinare i valori predefiniti)\n"
"\n"

