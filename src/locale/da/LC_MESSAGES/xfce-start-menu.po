#: src/sys_actions.py:283
#, python-brace-format
msgid ""
"Empty command specified for menu item '{key}'.\n"
"Enter a valid command or reset the setting.\n"
"\n"
"{hint}"
msgstr ""
"Tom kommando angivet for menupunktet '{key}'.\n"
"Indtast en gyldig kommando, eller nulstil indstillingen.\n"
"\n"
"{hint}"

#: src/sys_actions.py:297
#, python-brace-format
msgid ""
"Invalid command ('cmd') for menu item '{key}'.\n"
"The value must be a non-empty string or null.\n"
"\n"
"{hint}"
msgstr ""
"Ugyldig kommando ('cmd') for menupunktet '{key}'.\n"
"Værdien skal være en ikke-tom streng eller null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:307
#, python-brace-format
msgid ""
"Invalid package name ('pkg') for menu item '{key}'.\n"
"Specify a valid APT package name or set 'pkg' to null.\n"
"\n"
"{hint}"
msgstr ""
"Ugyldigt pakkenavn ('pkg') for menupunktet '{key}'.\n"
"Angiv et gyldigt APT-pakkenavn, eller sæt 'pkg' til null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:325
#, python-brace-format
msgid ""
"Invalid configuration format for menu item '{key}'.\n"
"Expected a command string or an object {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"
msgstr ""
"Ugyldigt konfigurationsformat for menupunktet '{key}'.\n"
"Forventede en kommandostreng eller et objekt {{\"cmd\": ..., "
"\"pkg\": ...}}.\n"
"\n"
"{hint}"

#: src/sys_actions.py:356
msgid ""
"No suitable application.\n"
"Under developing..."
msgstr ""
"Intet egnet program.\n"
"Under udvikling..."

#: src/sys_actions.py:367
#, python-brace-format
msgid ""
"Invalid command syntax for menu item '{key}'.\n"
"Check the quotes and arguments in:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"Ugyldig kommandosyntaks for menupunktet '{key}'.\n"
"Kontrollér anførselstegn og argumenter i:\n"
"{path}\n"
"\n"
"(eller slet filen for at gendanne standardindstillingerne)\n"
"\n"

