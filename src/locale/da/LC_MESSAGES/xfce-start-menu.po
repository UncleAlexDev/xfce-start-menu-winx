#: src/sys_actions.py:189
#, python-brace-format
msgid ""
"Command '{bin}' is not installed on your system, and package '{pkg}' was not "
"found in available software repositories.\n"
"\n"
"Check the 'cmd' and 'pkg' values for '{key}' in:\n"
"{path}"
msgstr ""
"Kommandoen '{bin}' er ikke installeret på dit system, og pakken '{pkg}' blev "
"ikke fundet i de tilgængelige pakkearkiver.\n"
"\n"
"Kontrollér værdierne for 'cmd' og 'pkg' for '{key}' i:\n"
"{path}"

