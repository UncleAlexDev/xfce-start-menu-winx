#: src/sys_actions.py:52
#, python-brace-format
msgid ""
"Failed to execute command '{cmd}':\n"
"{err}"
msgstr ""
"فشل تنفيذ الأمر '{cmd}':\n"
"{err}"

#: src/sys_actions.py:73
#, python-brace-format
msgid ""
"Application '{bin}' is not installed.\n"
"Install package '{pkg}' now?"
msgstr ""
"التطبيق '{bin}' غير مثبت.\n"
"هل تريد تثبيت الحزمة '{pkg}' الآن؟"

#: src/sys_actions.py:86
msgid "Installation complete. You can close this terminal."
msgstr "اكتمل التثبيت. يمكنك إغلاق هذه الطرفية."

#: src/sys_actions.py:87
msgid "Installation failed! You can close this terminal."
msgstr "فشل التثبيت! يمكنك إغلاق هذه الطرفية."

#: src/sys_actions.py:172
#, python-brace-format
msgid ""
"Continue with\n"
"{cmd}"
msgstr ""
"المتابعة باستخدام\n"
"{cmd}"

#: src/sys_actions.py:173 src/sys_cmd.py:146
msgid "Cancel"
msgstr "إلغاء"

#: src/sys_actions.py:189
#, python-brace-format
msgid ""
"Command '{bin}' is not installed on your system, and package '{pkg}' was not "
"found in available software repositories.\n"
"\n"
"Check the 'cmd' and 'pkg' values for '{key}' in:\n"
"{path}"
msgstr ""
"الأمر '{bin}' غير مثبت على نظامك، ولم يتم العثور على الحزمة '{pkg}' في "
"مستودعات البرامج المتاحة.\n"
"\n"
"تحقق من قيم 'cmd' و 'pkg' لـ '{key}' في:\n"
"{path}"

#: src/sys_actions.py:193 src/sys_actions.py:350 src/sys_actions.py:372
msgid "System Menu — Configuration Error"
msgstr "قائمة النظام — خطأ في التكوين"

#: src/sys_actions.py:230
#, python-brace-format
msgid ""
"Check file:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"تحقق من الملف:\n"
"{path}\n"
"\n"
"(أو احذف الملف لاستعادة الإعدادات الافتراضية)\n"
"\n"

#: src/sys_actions.py:248
#, python-brace-format
msgid ""
"Failed to read file:\n"
"{path}\n"
"\n"
"{err}"
msgstr ""
"فشلت قراءة الملف:\n"
"{path}\n"
"\n"
"{err}"

#: src/sys_actions.py:263
#, python-brace-format
msgid ""
"JSON syntax error in configuration file (line {line}, column {col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"
msgstr ""
"خطأ في صيغة JSON في ملف التكوين (السطر {line}، العمود {col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"

#: src/sys_actions.py:267
#, python-brace-format
msgid ""
"Configuration error:\n"
"{err}\n"
"\n"
"{hint}"
msgstr ""
"خطأ في التكوين:\n"
"{err}\n"
"\n"
"{hint}"

#: src/sys_actions.py:283
#, python-brace-format
msgid ""
"Empty command specified for menu item '{key}'.\n"
"Enter a valid command or reset the setting.\n"
"\n"
"{hint}"
msgstr ""
"تم تحديد أمر فارغ لعنصر القائمة '{key}'.\n"
"أدخل أمرًا صالحًا أو أعد ضبط الإعداد.\n"
"\n"
"{hint}"

#: src/sys_actions.py:297
#, python-brace-format
msgid ""
"Invalid command ('cmd') for menu item '{key}'.\n"
"The value must be a non-empty string or null.\n"
"\n"
"{hint}"
msgstr ""
"أمر غير صالح ('cmd') لعنصر القائمة '{key}'.\n"
"يجب أن تكون القيمة سلسلة غير فارغة أو null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:307
#, python-brace-format
msgid ""
"Invalid package name ('pkg') for menu item '{key}'.\n"
"Specify a valid APT package name or set 'pkg' to null.\n"
"\n"
"{hint}"
msgstr ""
"اسم حزمة غير صالح ('pkg') لعنصر القائمة '{key}'.\n"
"حدد اسم حزمة APT صالحًا أو اضبط 'pkg' على null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:325
#, python-brace-format
msgid ""
"Invalid configuration format for menu item '{key}'.\n"
"Expected a command string or an object {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"
msgstr ""
"تنسيق تكوين غير صالح لعنصر القائمة '{key}'.\n"
"يُتوقع سلسلة أمر أو كائن {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"

#: src/sys_actions.py:356
msgid ""
"No suitable application.\n"
"Under developing..."
msgstr ""
"لا يوجد تطبيق مناسب.\n"
"قيد التطوير..."

#: src/sys_actions.py:367
#, python-brace-format
msgid ""
"Invalid command syntax for menu item '{key}'.\n"
"Check the quotes and arguments in:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"صيغة أمر غير صالحة لعنصر القائمة '{key}'.\n"
"تحقق من علامات الاقتباس والوسائط في:\n"
"{path}\n"
"\n"
"(أو احذف الملف لاستعادة الإعدادات الافتراضية)\n"
"\n"

#: src/sys_cmd.py:138 src/sys_cmd.py:147 src/sys_cmd.py:334
#: src/sys_winx_menu.py:204
msgid "Run"
msgstr "تشغيل"

#: src/sys_cmd.py:158
msgid "Type the name of a program, folder, or command to run:"
msgstr "اكتب اسم برنامج أو مجلد أو أمر لتشغيله:"

#: src/sys_cmd.py:173
msgid "Command... (Tab to complete)"
msgstr "أمر... (اضغط Tab للإكمال)"

#: src/sys_cmd.py:332
#, python-brace-format
msgid "Failed to run '{cmd}'"
msgstr "فشل تشغيل '{cmd}'"

#: src/sys_shortcuts.py:151
msgid "Keyboard shortcuts mismatch detected for Xfce Start Menu."
msgstr "تم اكتشاف عدم تطابق في اختصارات لوحة المفاتيح لقائمة ابدأ Xfce."

#: src/sys_shortcuts.py:156
msgid ""
"Fix incompatible shortcuts now?\n"
"If left as is, system menu hotkeys may work unstably.\n"
"You can also review them manually in: Settings → Keyboard → Application "
"Shortcuts.\n"
"\n"
msgstr ""
"هل تريد إصلاح الاختصارات غير المتوافقة الآن؟\n"
"إذا تُركت كما هي، فقد تعمل مفاتيح الاختصار لقائمة النظام بشكل غير مستقر.\n"
"يمكنك أيضًا مراجعتها يدويًا في: الإعدادات ← لوحة المفاتيح ← اختصارات "
"التطبيقات.\n"
"\n"

#: src/sys_shortcuts.py:163
msgid "Leave as is"
msgstr "تركها كما هي"

#: src/sys_shortcuts.py:164
msgid "Open Keyboard..."
msgstr "فتح إعدادات لوحة المفاتيح..."

#: src/sys_shortcuts.py:165
msgid "Fix now"
msgstr "إصلاح الآن"

