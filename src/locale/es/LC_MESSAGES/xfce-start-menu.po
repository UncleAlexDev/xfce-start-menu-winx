#: src/sys_actions.py:283
#, python-brace-format
msgid ""
"Empty command specified for menu item '{key}'.\n"
"Enter a valid command or reset the setting.\n"
"\n"
"{hint}"
msgstr ""
"Se especificó un comando vacío para el elemento '{key}'.\n"
"Introduzca un comando válido o restablezca la configuración.\n"
"\n"
"{hint}"

#: src/sys_actions.py:297
#, python-brace-format
msgid ""
"Invalid command ('cmd') for menu item '{key}'.\n"
"The value must be a non-empty string or null.\n"
"\n"
"{hint}"
msgstr ""
"Comando ('cmd') no válido para el elemento '{key}'.\n"
"El valor debe ser una cadena no vacía o null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:307
#, python-brace-format
msgid ""
"Invalid package name ('pkg') for menu item '{key}'.\n"
"Specify a valid APT package name or set 'pkg' to null.\n"
"\n"
"{hint}"
msgstr ""
"Nombre de paquete ('pkg') no válido para el elemento '{key}'.\n"
"Especifique un nombre de paquete APT válido o establezca 'pkg' en null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:325
#, python-brace-format
msgid ""
"Invalid configuration format for menu item '{key}'.\n"
"Expected a command string or an object {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"
msgstr ""
"Formato de configuración no válido para el elemento '{key}'.\n"
"Se esperaba una cadena de comando o un objeto {{\"cmd\": ..., "
"\"pkg\": ...}}.\n"
"\n"
"{hint}"

#: src/sys_actions.py:356
msgid ""
"No suitable application.\n"
"Under developing..."
msgstr ""
"No hay una aplicación adecuada.\n"
"En desarrollo..."

#: src/sys_actions.py:367
#, python-brace-format
msgid ""
"Invalid command syntax for menu item '{key}'.\n"
"Check the quotes and arguments in:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"Sintaxis de comando no válida para el elemento '{key}'.\n"
"Revise las comillas y los argumentos en:\n"
"{path}\n"
"\n"
"(o elimine el archivo para restaurar los valores predeterminados)\n"
"\n"

