#: src/sys_actions.py:189
#, python-brace-format
msgid ""
"Command '{bin}' is not installed on your system, and package '{pkg}' was not "
"found in available software repositories.\n"
"\n"
"Check the 'cmd' and 'pkg' values for '{key}' in:\n"
"{path}"
msgstr ""
"El comando '{bin}' no está instalado en su sistema y no se encontró el "
"paquete '{pkg}' en los repositorios disponibles.\n"
"\n"
"Revise los valores de 'cmd' y 'pkg' para '{key}' en:\n"
"{path}"

