#: src/sys_actions.py:73
#, python-brace-format
msgid ""
"Application '{bin}' is not installed.\n"
"Install package '{pkg}' now?"
msgstr ""
"Приложение «{bin}» не установлено.\n"
"Установить пакет «{pkg}» сейчас?"

#: src/sys_actions.py:86
msgid "Installation complete. You can close this terminal."
msgstr "Установка завершена. Вы можете закрыть этот терминал."

#: src/sys_actions.py:87
msgid "Installation failed! You can close this terminal."
msgstr "Ошибка установки! Вы можете закрыть этот терминал."

#: src/sys_actions.py:172
#, python-brace-format
msgid ""
"Continue with\n"
"{cmd}"
msgstr ""
"Продолжить с\n"
"{cmd}"

#: src/sys_actions.py:173 src/sys_cmd.py:146
msgid "Cancel"
msgstr "Отмена"

#: src/sys_actions.py:189
#, python-brace-format
msgid ""
"Command '{bin}' is not installed on your system, and package '{pkg}' was not "
"found in available software repositories.\n"
"\n"
"Check the 'cmd' and 'pkg' values for '{key}' in:\n"
"{path}"
msgstr ""
"Команда «{bin}» не установлена в системе, а пакет «{pkg}» не найден в "
"подключённых репозиториях.\n"
"\n"
"Проверьте значения 'cmd' и 'pkg' для «{key}» в файле:\n"
"{path}"

#: src/sys_actions.py:193 src/sys_actions.py:350 src/sys_actions.py:372
msgid "System Menu — Configuration Error"
msgstr "Системное меню — ошибка конфигурации"

#: src/sys_actions.py:230
#, python-brace-format
msgid ""
"Check file:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"Проверьте файл:\n"
"{path}\n"
"\n"
"(или удалите файл, чтобы восстановить настройки по умолчанию)\n"
"\n"

#: src/sys_actions.py:248
#, python-brace-format
msgid ""
"Failed to read file:\n"
"{path}\n"
"\n"
"{err}"
msgstr ""
"Не удалось прочитать файл:\n"
"{path}\n"
"\n"
"{err}"

#: src/sys_actions.py:263
#, python-brace-format
msgid ""
"JSON syntax error in configuration file (line {line}, column {col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"
msgstr ""
"Синтаксическая ошибка JSON в файле конфигурации (строка {line}, столбец "
"{col}):\n"
"\n"
"{msg}\n"
"\n"
"{hint}"

#: src/sys_actions.py:267
#, python-brace-format
msgid ""
"Configuration error:\n"
"{err}\n"
"\n"
"{hint}"
msgstr ""
"Ошибка конфигурации:\n"
"{err}\n"
"\n"
"{hint}"

#: src/sys_actions.py:283
#, python-brace-format
msgid ""
"Empty command specified for menu item '{key}'.\n"
"Enter a valid command or reset the setting.\n"
"\n"
"{hint}"
msgstr ""
"Для пункта меню «{key}» указана пустая команда.\n"
"Введите корректную команду или сбросьте настройку.\n"
"\n"
"{hint}"

#: src/sys_actions.py:297
#, python-brace-format
msgid ""
"Invalid command ('cmd') for menu item '{key}'.\n"
"The value must be a non-empty string or null.\n"
"\n"
"{hint}"
msgstr ""
"Некорректная команда ('cmd') для пункта меню «{key}».\n"
"Значение должно быть непустой строкой или null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:307
#, python-brace-format
msgid ""
"Invalid package name ('pkg') for menu item '{key}'.\n"
"Specify a valid APT package name or set 'pkg' to null.\n"
"\n"
"{hint}"
msgstr ""
"Некорректное имя пакета ('pkg') для пункта меню «{key}».\n"
"Укажите существующее имя APT-пакета или задайте null.\n"
"\n"
"{hint}"

#: src/sys_actions.py:325
#, python-brace-format
msgid ""
"Invalid configuration format for menu item '{key}'.\n"
"Expected a command string or an object {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"
msgstr ""
"Неверный формат настройки для пункта меню «{key}».\n"
"Ожидается строка с командой или объект {{\"cmd\": ..., \"pkg\": ...}}.\n"
"\n"
"{hint}"

#: src/sys_actions.py:356
msgid ""
"No suitable application.\n"
"Under developing..."
msgstr ""
"Подходящее приложение не найдено.\n"
"Функция в разработке..."

#: src/sys_actions.py:367
#, python-brace-format
msgid ""
"Invalid command syntax for menu item '{key}'.\n"
"Check the quotes and arguments in:\n"
"{path}\n"
"\n"
"(or delete the file to restore defaults)\n"
"\n"
msgstr ""
"Ошибка синтаксиса команды для пункта меню «{key}».\n"
"Проверьте кавычки и аргументы в файле:\n"
"{path}\n"
"\n"
"(или удалите файл, чтобы восстановить настройки по умолчанию)\n"
"\n"

